{
  "manifest_version": 3,
  "name": "Gravity Mode",
  "version": "1.0.0",
  "description": "Derruba os elementos da pagina quando voce passa o mouse, igual ao easter egg do Google Gravity.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gravity Mode"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
